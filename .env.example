# CONFIGURACIÓN DEL SERVIDOR
SERVER_HOST=0.0.0.0
SERVER_PORT=9000

# CONFIGURACIÓN DEL CLIENTE
CLIENT_HOST=127.0.0.1
CLIENT_PORT=9000

# CONFIGURACIÓN DE LA API REST
API_HOST=0.0.0.0
API_PORT=8000

# CONFIGURACIÓN DE LOGS
LOG_FILE=logs/chat.log
LOG_MAX_BYTES=5000000
LOG_BACKUPS=3

# CONFIGURACIÓN SSL/TLS
# Habilitar SSL/TLS (true/false)
SSL_ENABLED=true
# Ruta al certificado del servidor
SSL_CERT_FILE=certificates/server.crt
# Ruta a la clave privada del servidor
SSL_KEY_FILE=certificates/server.key
# Ruta al certificado CA (para verificación del cliente)
SSL_CA_FILE=certificates/ca.crt

# CONFIGURACIÓN CRIPTOGRÁFICA
# Salt para HMAC (cambiar en producción por un valor aleatorio seguro)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SALT=change_this_to_a_random_secure_value_in_production

# CONFIGURACIÓN SERVIDOR DE ARCHIVOS (v6.0)
# Directorio donde se guardan los archivos subidos
UPLOAD_DIR=uploads
# Directorio donde se guardan las firmas digitales
SIGNATURES_DIR=signatures
# Ruta a la clave privada para firmar archivos
SIGNING_PRIVATE_KEY=signing_keys/signing_private_key.pem
# Ruta a la clave pública para verificar firmas
SIGNING_PUBLIC_KEY=signing_keys/signing_public_key.pem
# Host del servidor de archivos
FILE_SERVER_HOST=0.0.0.0
# Puerto del servidor de archivos
FILE_SERVER_PORT=8080
# Tamaño máximo de archivo en bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# CONFIGURACIÓN HISTORIAL DE MENSAJES
# Archivo donde se guarda el historial de mensajes
MESSAGE_HISTORY_FILE=chat_history.json
# Horas antes de eliminar mensajes antiguos (0 = sin límite)
MESSAGE_TTL_HOURS=24
# Máximo de mensajes a mantener en el historial
MESSAGE_MAX_COUNT=1000

# OAuth 2.0 con Google (Requerido para autenticación OAuth)
# Client ID de Google OAuth (obtenido de Google Cloud Console)
# Formato: xxxxxx-xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=tu_google_client_id_aqui

# Client Secret de Google OAuth (obtenido de Google Cloud Console)
# Formato: GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui

# Redirect URI: URL donde Google redirige después de la autorización
# Debe coincidir EXACTAMENTE con la configurada en Google Cloud Console
# IMPORTANTE: Debe apuntar al BACKEND, no al frontend
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Scopes: Permisos que solicita tu aplicación
# Estos son los scopes mínimos: openid (identidad), email (correo), profile (perfil)
GOOGLE_SCOPES="openid email profile"

# Discovery Document: URL del documento de descubrimiento de Google
# Generalmente no necesita cambiarse
GOOGLE_DISCOVERY=https://accounts.google.com/.well-known/openid-configuration

# SSL Verification: Verificar certificados SSL al conectar con Google (true/false)
# En desarrollo local puedes usar false si hay problemas con certificados
# En producción SIEMPRE debe ser true
OAUTH_VERIFY_SSL=false

# NOTAS IMPORTANTES
# ============================================
# 1. Copia este archivo a .env y ajusta los valores
# 2. NUNCA subas el archivo .env al repositorio (está en .gitignore)
# 3. Genera certificados SSL con: python generate_ssl_cert.py
# 4. Cambia HMAC_SALT por un valor aleatorio seguro en producción
# 5. Genera claves de firma con: python -c "from digital_signature import generate_signing_key_pair; generate_signing_key_pair()"
# 6. Para configurar OAuth 2.0 con Google, consulta: docs/CONFIGURACION_OAUTH.md
# 7. El GOOGLE_REDIRECT_URI debe apuntar al BACKEND (http://localhost:8000/api/auth/google/callback)
# 8. También debes configurar el mismo URI en Google Cloud Console > Credentials > OAuth Client ID